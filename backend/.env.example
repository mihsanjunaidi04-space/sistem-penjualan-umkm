RAILS_ENV=development
# Development/test generate a local process-only signing secret in the application.
# Development/test CORS allows the frontend at http://localhost:5173.
# Production must set JWT_SECRET (at least 32 bytes) via environment or Rails credentials.
# Example format only: output of `openssl rand -hex 32`; generate a unique value, never copy a shared secret.
JWT_SECRET=
# Production must set CORS_ALLOWED_ORIGINS to comma-separated HTTPS origins.
# Example format only: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=
# All values above are placeholders; this file contains no real secrets or credentials.
